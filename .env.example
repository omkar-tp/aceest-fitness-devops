# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
JENKINS_ADMIN_PASSWORD=admin123

# Host port for SonarQube (use 9099 if 9000 is taken, e.g. by a VPN agent).
SONAR_HOST_PORT=9000

# Docker Hub (create an access token at hub.docker.com > Account Settings > Security).
DOCKERHUB_USER=local
DOCKERHUB_TOKEN=not-set

# Written by scripts/bootstrap-ci.sh
SONAR_TOKEN=not-set

# Optional: base64 of your kubeconfig for deploy stages (Linux: base64 -w0 ~/.kube/config).
KUBECONFIG_B64=e30=
